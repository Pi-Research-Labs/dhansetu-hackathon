[Unit]
Description=DhanSetu FastAPI Backend Service
After=network.target postgresql.service

[Service]
User=tarun_kesavan
WorkingDirectory=/home/tarun_kesavan/dhansetu-hackathon/backend
ExecStart=/home/tarun_kesavan/dhansetu-hackathon/backend/venv/bin/python3 -m fastapi run app/main.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/home/tarun_kesavan/dhansetu-hackathon/backend/.env

[Install]
WantedBy=multi-user.target
