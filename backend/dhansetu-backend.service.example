[Unit]
Description=DhanSetu FastAPI backend
After=network.target postgresql.service

[Service]
Type=simple
User=tarunmenon
WorkingDirectory=/home/tarunmenon/dhansetu-backend
EnvironmentFile=/home/tarunmenon/dhansetu-backend/.env
ExecStart=/home/tarunmenon/dhansetu-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
