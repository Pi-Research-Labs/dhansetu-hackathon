APP_NAME=DhanSetu API
CORS_ORIGINS=["*"]

# Ask a teammate for the real value out-of-band (Slack/in person) — never commit it.
# See ../database/README.md for schema docs and the views-only access rule.
# NOTE: if the password contains "@", URL-encode it as %40, or the parser will
# think it's the userinfo/host separator and fail to connect.
DATABASE_URL=postgresql://dhansetu_user:<password>@<VM_EXTERNAL_IP>:5432/dhansetu

# Used to sign merchant-login JWTs (backend/app/core/security.py). Generate a
# real one for anything beyond local dev: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-me
